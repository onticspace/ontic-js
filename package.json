{
  "name": "ontic-js",
  "version": "0.1.0",
  "description": "Independent verification of Ontic statements and external account attestations",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./sodium": "./src/sodium.js"
  },
  "files": [
    "src",
    "README.md",
    "download-proofs.py"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:example": "esbuild src/index.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=example/ontic.bundle.js"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
